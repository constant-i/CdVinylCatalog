<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила для API 28-30. Для API 31+ действует data_extraction_rules.xml.

   Здесь, в отличие от xml/backup_rules.xml, фото удаётся разделить:
   атрибут requireFlags="deviceToDeviceTransfer" включает файлы только
   при переносе между устройствами, но не при выгрузке в облако.

   Причина разделения — квота: облачная копия ограничена 25 МБ на
   приложение, и при превышении не создаётся ЦЕЛИКОМ, вместе с базой.
   Пять фото по ~300 КБ на диск дают до 2 МБ на запись, так что коллекция
   из десятка дисков с фотографиями уже не влезет. Перенос по кабелю
   лимита не имеет (там речь о гигабайтах), поэтому туда фото идут.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include
        domain="file"
        path="photos/"
        requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
