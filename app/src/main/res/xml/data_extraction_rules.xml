<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила для Android 12+ (API 31), где облачная копия и перенос на новое
   устройство описаны отдельно.

   Состав разный намеренно. Облачная копия ограничена 25 МБ на приложение,
   и при превышении не создаётся ЦЕЛИКОМ — вместе с базой. Пять фото по
   ~300 КБ на диск дают до 2 МБ на запись, так что коллекция из десятка
   дисков уже не влезет. Поэтому в облако идёт только база: записи о дисках
   восстановить руками невозможно, а фотографии можно переснять.

   Перенос по кабелю лимита не имеет, поэтому туда попадают и снимки —
   это самый частый сценарий смены телефона.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
