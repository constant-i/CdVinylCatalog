<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила для API 26-27. Для API 28+ действует xml-v28/backup_rules.xml,
   для API 31+ — data_extraction_rules.xml.

   Здесь фото не попадают даже при переносе по кабелю: атрибут requireFlags
   появился только в Android 9 (API 28), а без него старый механизм не умеет
   отличать облако от переноса. Выбор в пользу базы — записи о дисках
   восстановить руками невозможно, а фотографии можно переснять.
   На API 28+ это ограничение снято, см. xml-v28/backup_rules.xml.
-->
<full-backup-content>
    <include domain="database" path="." />
</full-backup-content>
